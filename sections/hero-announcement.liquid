<div class="hero-banner" style="background-color: {{ section.settings.bg_color }}">
  <h1>{{ section.settings.headline }}</h1>
  <p>Use code: <strong>{{ section.settings.discount_code }}</strong></p>
  <a href="{{ section.settings.cta_link }}" class="hero-cta">{{ section.settings.cta_text }}</a>
</div>

{% schema %}
{
  "name": "Hero Announcement",
  "settings": [
    { "type": "text", "id": "headline", "label": "Headline", "default": "Big Sale!" },
    { "type": "text", "id": "discount_code", "label": "Discount Code" },
    { "type": "url", "id": "cta_link", "label": "CTA Link" },
    { "type": "text", "id": "cta_text", "label": "Button Text", "default": "Shop Now" },
    { "type": "color", "id": "bg_color", "label": "Background Color", "default": "#111111" }
  ],
  "presets": [{ "name": "Hero Announcement" }]
}
{% endschema %}